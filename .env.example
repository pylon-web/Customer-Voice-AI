# ==============================================================================
# Customer Voice AI — Environment Configuration Example
# ==============================================================================
# Fictional Enterprise: Acme Financial Services
# DO NOT COMMIT REAL SECRETS TO VERSION CONTROL
# ==============================================================================

# Application Environment
ENVIRONMENT=development
DEBUG=true
LOG_LEVEL=INFO
APP_NAME="Customer Voice AI"
APP_VERSION="0.1.0"
API_V1_STR=/api/v1
SECRET_KEY=change-this-in-production-use-strong-secret-key-32-chars-min

# Server Configuration
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
BACKEND_CORS_ORIGINS=["http://localhost:3000","http://localhost:5173","http://127.0.0.1:3000","http://127.0.0.1:5173"]

# PostgreSQL + pgvector
POSTGRES_SERVER=localhost
POSTGRES_PORT=5432
POSTGRES_USER=customervoice
POSTGRES_PASSWORD=customervoice_secret
POSTGRES_DB=customer_voice_ai
POSTGRES_POOL_SIZE=10
POSTGRES_MAX_OVERFLOW=20
DATABASE_URL=postgresql+asyncpg://customervoice:customervoice_secret@localhost:5432/customer_voice_ai

# Apache Kafka Configuration
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_CONSUMER_GROUP=customer-voice-ai-workers
KAFKA_ENABLE_FALLBACK_SYNC=true
KAFKA_TOPIC_REVIEW_CREATED=review.created
KAFKA_TOPIC_REVIEW_ANALYZED=review.analyzed
KAFKA_TOPIC_REVIEW_EMBEDDED=review.embedded
KAFKA_TOPIC_ISSUE_DETECTED=issue.detected
KAFKA_TOPIC_REPORT_GENERATED=report.generated

# AI / LLM Configuration
# Options: "mock" (for zero-cost offline local dev & tests), "openai", "azure_openai"
LLM_PROVIDER=mock
OPENAI_API_KEY=your_openai_api_key_here
LLM_MODEL=gpt-4o-mini
LLM_TEMPERATURE=0.1
LLM_MAX_TOKENS=1024

# Embedding Configuration
EMBEDDING_PROVIDER=mock
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSION=1536

# Clustering & Trend Detection Configuration
CLUSTERING_MIN_SAMPLES=5
CLUSTERING_EPS=0.35
TREND_BASELINE_WEEKS=4
TREND_EMERGING_THRESHOLD_PCT=25.0

# Frontend Configuration (for Vite)
VITE_API_BASE_URL=http://localhost:8000/api/v1
